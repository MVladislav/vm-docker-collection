---
tcp:
  serversTransports:
    pp-transport-v1:
      proxyProtocol:
        version: 1
    pp-transport-v2:
      proxyProtocol:
        version: 2

http:
  middlewares:
    # --------------------------------------------------------------------------
    crowdsec:
      plugin:
        crowdsec:
          enabled: true
          logLevel: INFO
          crowdsecMode: stream
          updateIntervalSeconds: 60
          updateMaxFailure: -1
          streamStartupBlock: true
          metricsUpdateIntervalSeconds: 600
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: crowdsec:7422
          crowdsecAppsecScheme: http
          crowdsecAppsecBodyLimit: 10485760
          crowdsecAppsecUnreadableBodyBlock: false
          crowdsecAppsecUnreachableBlock: false
          crowdsecAppsecFailureBlock: false
          # Single node: traefik drops inbound X-Forwarded-For and sets it from
          # the connection peer, so an empty list is correct. Multi-node only
          # (443:8443 SNI proxy): list the proxy IPs, same values as
          # TRAEFIK_ENTRYPOINTS_WEBSECURE_PROXYPROTOCOL_TRUSTEDIPS.
          # forwardedHeadersTrustedIPs:
          #   - "127.0.0.1/32"
          #   - "::1/128"
          remediationHeadersCustomName: cs-remediation
          crowdsecLapiKeyFile: /run/secrets/crowdsec_lapi_key
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiScheme: http
          httpTimeoutSeconds: 10
          banHTMLFilePath: /etc/traefik/ban.html
    # --------------------------------------------------------------------------
    # badger:
    #   plugin:
    #     badger:
    #       disableForwardAuth: true
    # --------------------------------------------------------------------------
    redirect-to-https:
      redirectScheme:
        scheme: https

    # --------------------------------------------------------------------------
    traefik-basic-auth:
      basicAuth:
        usersFile: "/run/secrets/traefik_basicauth_secret"
        realm: "Traefik Basic Auth"

    # --------------------------------------------------------------------------
    default-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        frameDeny: true
        referrerPolicy: "strict-origin-when-cross-origin"
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 15552000
        customFrameOptionsValue: SAMEORIGIN
        customResponseHeaders:
          X-Permitted-Cross-Domain-Policies: "none"
          Permissions-Policy: "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        customRequestHeaders:
          X-Forwarded-Proto: https

    # --------------------------------------------------------------------------
    # The console on :3002 serves the browser document and sets no headers of its
    # own, so the baseline below is added here. Per-router, not on the entrypoint:
    # an entrypoint middleware would also land on every router Pangolin generates
    # per proxied resource, and those serve third-party apps with their own CSP.
    # 'unsafe-inline' is required - the App Router document ships inline scripts.
    dashboard-security-headers:
      headers:
        contentSecurityPolicy: >-
          default-src 'self';
          script-src 'self' 'unsafe-inline';
          style-src 'self' 'unsafe-inline';
          img-src 'self' data: blob:;
          font-src 'self' data:;
          connect-src 'self';
          object-src 'none';
          base-uri 'self';
          frame-ancestors 'none';
          upgrade-insecure-requests
        customResponseHeaders:
          Cross-Origin-Opener-Policy: "same-origin-allow-popups"
          Cross-Origin-Resource-Policy: "same-origin"
          # Cross-Origin-Embedder-Policy: "credentialless"

    # --------------------------------------------------------------------------
    public-whitelist:
      IPAllowList:
        sourceRange:
          - 0.0.0.0/0
          - ::/0

    # --------------------------------------------------------------------------
    public-secured:
      chain:
        middlewares:
          - public-whitelist
          - default-headers

  # ############################################################################
  routers:
    # # Traefik
    # traefik-router:
    #   rule: "Host(`<REPLACE_TRAEFIK_DOMAIN>`)" # REPLACE THIS WITH YOUR DOMAIN
    #   service: api@internal
    #   entryPoints:
    #     - websecure
    #   middlewares:
    #     # - badger
    #     - traefik-basic-auth@file
    #   tls:
    #     certResolver: certificates

    # # HTTP to HTTPS redirect router
    # main-app-router-redirect:
    #   rule: "Host(`<REPLACE_DASHBOARDURL>`)" # REPLACE THIS WITH YOUR DOMAIN
    #   service: next-service
    #   entryPoints:
    #     - web
    #   middlewares:
    #     - redirect-to-https
    #     - badger

    # Next.js router (handles everything except API and WebSocket paths)
    next-router:
      rule: "Host(`<REPLACE_DASHBOARDURL>`) && !PathPrefix(`/api/v1`)" # REPLACE THIS WITH YOUR DOMAIN
      service: next-service
      entryPoints:
        - websecure
      middlewares:
        # - badger
        - dashboard-security-headers@file
      tls:
        certResolver: certificates

    # API router (handles /api/v1 paths)
    api-router:
      rule: "Host(`<REPLACE_DASHBOARDURL>`) && PathPrefix(`/api/v1`)" # REPLACE THIS WITH YOUR DOMAIN
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        # - badger
        - dashboard-security-headers@file
      tls:
        certResolver: certificates

    # WebSocket router
    ws-router:
      rule: "Host(`<REPLACE_DASHBOARDURL>`)" # REPLACE THIS WITH YOUR DOMAIN
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        # - badger
        - dashboard-security-headers@file
      tls:
        certResolver: certificates

  # ############################################################################
  services:
    next-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3002" # Next.js server

    api-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3000" # API/WebSocket server
