---
# yamllint configuration
# https://yamllint.readthedocs.io/en/stable/configuration.html
extends: default
rules:
  # long traefik labels are common in this repo - prettier handles formatting
  line-length: false
  # compose files start with `---`; enforce that
  document-start:
    present: true
  # keep single space between content and comments (prettier style)
  comments:
    min-spaces-from-content: 1
  # `yes`/`no` are used as values in compose environment blocks
  truthy:
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: whatever
    check-multi-line-strings: false
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1
  comments-indentation:
    ignore: |
      composer/**
      __template/**
